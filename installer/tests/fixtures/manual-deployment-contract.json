{
  "schema": "fwrouter-manual-deployment-contract/v2",
  "execution": "owner-invoked-local-only",
  "wrapper_distribution": "outside-repository-owner-controlled",
  "source": "verified-existing-local-git-objects",
  "remote_purpose": "metadata-and-ci-evidence-only",
  "automatic_deployment": false,
  "initial_scopes": [
    "ui"
  ],
  "unsupported_scopes": [
    "backend",
    "host",
    "mihomo",
    "xray",
    "schema",
    "recovery"
  ],
  "prohibited_operations": [
    "git fetch",
    "git pull",
    "git checkout",
    "git reset",
    "git merge",
    "git clone",
    "deploy from downloaded artifacts",
    "automatic restart",
    "automatic reconcile"
  ],
  "temporary_log_days": 7,
  "permanent_receipts_in_tmpfiles_scope": false,
  "required_scenarios": [
    {
      "id": 1,
      "name": "exact_sha_success",
      "production_allowed": false
    },
