  "qualification_boundary": "Public CI verifies this contract and synthetic data only; private wrapper qualification must bind separately reviewed private implementation hashes.",
  "ui_publication": {
    "installer_operation": "installer/install.sh --deploy --component ui",
    "target": "/opt/fwrouter-ui",
    "managed_release_root": "/opt/.fwrouter-ui-releases",
    "publisher": "installer/ui_publication.py",
    "atomic_switch": "renameat2(RENAME_EXCHANGE)",
    "shared_lock": "/opt/.fwrouter-component-install.lock",
    "restore": "explicit-only-through-the-same-publisher",
    "wrapper_may_mutate_pointer": false,
    "native_proof_attests_ui_pointer": false,
    "guarantees": [
      "server-side-path-resolution"
    ],
    "not_guaranteed": [
      "browser-session-across-requests",
      "browser-cache-coherence"
    ],
    "deploy_side_effects": [
      "bootstrap-state-directories-and-markers",
      "state-database-and-backup-permissions",
      "api-env-mode-0600"
    ],
    "automatic_rollback": false
  },
  "native_proof": {
    "command": "fwrouter native-proof --scope ui",
    "proof_schema_version": 1,
    "accepted_status": "PASS",
    "rejected_statuses": [
      "FAIL",
      "STALE",
      "INCOMPLETE"
    ],
    "identity_fields": [
      "source_identity.kind",
      "source_identity.sha256",
      "source_identity.commit_sha"
    ],
    "backend_identity": "installer-canonical-filtered-content-manifest-rooted-at-executing-module",
    "runtime_identity": "pinned-local-docker-image-configuration-id",
    "required_checks": [
      "backend_manifest_sha256",
      "sqlite_schema_integrity_foreign_keys",
      "generation_owner_state",
      "checkpoint_state",
      "xray_identity_bindings_config_runtime",
      "mihomo_config_rules_selectors_runtime",
      "core_manifest_nft_ip_routing_runtime",
      "final_native_runtime_fence_recheck",
      "generation_native_receipt_exact_match"
    ],
    "side_effects": [],
    "missing_owner_receipt": "STOP; no synthetic receipt, legacy admission, staging, refresh, reconcile, apply, or recovery"
  },
  "legacy_backend_prerequisite": "The installed backend must expose native-proof and have current valid Core and generation owner receipts; otherwise STOP pending a separately authorized normal owner operation. UI-only deployment cannot install this prerequisite.",
  "privileged_execution_trust": {
    "fixed_executable_paths": true,
    "root_owned_regular_files": true,
    "reject_group_or_world_writable": true,
    "trusted_parent_directories": true,
    "bind_verified_file_to_execution": true,
    "os_runtime_closure_separate_gate": true,
    "automatic_host_pin_approval": false,
    "malicious_root_peer_excluded": true
  },
  "backend_prerequisite": {
    "authority": "separate-owner-authorized-controlled-backend-operation",
    "wrapper_scope_remains": "ui",
    "expected_schema": 27,
    "implicit_migration": false,
    "automatic_backend_bootstrap": false,
    "old_installed_source_controls_stop": true,
    "transfer_requires_operation_and_old_new_manifest_cas": true,
    "installer_argv": [
      "installer/install.sh",
      "--deploy",
      "--component",
      "backend"
    ],
    "readiness_command": [
      "fwrouter",
      "native-proof",
      "--scope",
      "ui",
      "--expected-backend-manifest-sha256",
      "APPROVED_BACKEND_SHA256",
      "--expected-xray-image-digest",
      "sha256:APPROVED_XRAY_IMAGE_ID",
      "--expected-mihomo-image-digest",
      "sha256:APPROVED_MIHOMO_IMAGE_ID"
    ],
    "missing_owner_receipts": "STOP-separate-existing-owner-qualification-required",
    "fabricated_marker_or_projection": false,
    "health_alone_is_sufficient": false,
    "restore_or_rollback": "separate-reviewed-recovery-decision-no-automatic-db-restore",
    "timer_catchup": "explicit-owner-decision-after-health-and-native-readiness",
    "ordered_boundaries": [
      "readonly-preflight",
      "verified-backup-and-independent-access",
      "old-source-controlled-stop",
      "new-source-cas-transfer",
      "existing-backend-installer",
      "schema-and-export-verification",
      "explicit-api-start-and-health",
      "fresh-native-proof-replay",
      "controlled-resume-and-timer-decision",
      "fresh-ui-preflight"
    ]
  }
