{
  "schema": "fwrouter-manual-deployment-contract/v3",
  "execution": "owner-invoked-local-only",
  "wrapper_distribution": "outside-repository-owner-controlled",
  "source": "verified-existing-local-git-objects",
  "remote_purpose": "metadata-and-ci-evidence-only",
  "ci_evidence": {
    "source_of_truth": "fresh-read-only-GitHub-API-metadata",
    "repository": "Coxf0rd/fwrouter",
    "workflow": "FWRouter affected CI",
    "workflow_path": ".github/workflows/test-gates.yml",
    "event": "push",
    "ref": "refs/heads/main",
    "required_check": "Affected L0-L5 with hosted profiles",
    "required_check_conclusion": "success",
    "workflow_conclusion": "success",
    "actual_runner_job_count": 16,
    "expected_runner_job_names": [
      "Immutable plan and preflight",
      "Build and verify source once",
      "Routine and contract shard (core-state)",
      "Routine and contract shard (routing-adapters)",
      "Routine and contract shard (services-events)",
      "Routine and contract shard (ui-tooling)",
      "Routine and contract shard (api-persistence-contracts)",
      "Routine and contract shard (ui-provider-contracts)",
      "Routine and contract shard (local-integration)",
      "Routine and contract shard (installer-startup)",
      "Ordinary functional and browser",
      "Provider and browser cohort",
      "Kernel packet and fail-closed",
      "Qualified native profile (qcp)",
      "Qualified native profile (xray)",
      "Affected L0-L5 with hosted profiles"
    ],
    "job_inventory_policy": "exact-names-no-missing-duplicate-extra-or-skipped-jobs",
    "current_attempt_jobs_only": true,
    "main_smoke_required_and_passed": true,
    "artifact_name_format": "fwrouter-main-evidence-{source_sha}-{run_id}-{run_attempt}",
    "artifact_retention_days": 7,
    "artifact_must_be_unexpired_and_available": true,
    "artifact_metadata_fields": [
      "artifact_id",
      "name",
      "size_in_bytes",
      "digest",
      "expired",
      "expires_at",
      "workflow_run_id",
      "workflow_run_head_sha"
    ],
    "attempt_binding": "current workflow run_attempt plus attempt-specific jobs API and exact artifact name; artifact API does not expose a run_attempt field",
    "bundle_must_retain": [
      "strict-aggregate-and-required-result",
      "immutable-plan-and-manifest",
      "source-and-build-digests",
      "sealed-current-attempt-producer-evidence",
      "routine-shard-node-inventory",
      "native-mihomo-xray-proofs",
      "kernel-packet-receipts",
      "hosted-provider-and-browser-receipts",
      "safe-recovery-receipts",
      "main-smoke-receipt",
      "offline-verifier-source-and-content-manifest"
    ],
    "offline_verifier": "tests/gates/evidence_bundle.py verify --require-main with exact SHA/event/ref/run/attempt from fresh API metadata",
    "verifier_source": "clean-trusted-local-checkout-at-exact-source-sha",
    "execute_code_from_bundle": false,
    "cached_bundle_fallback": false,
    "legacy_ci_v2_artifact_fallback": false,
    "missing_or_expired_evidence": "STOP",
    "artifact_max_size_bytes": 536870912
  },
  "l6_policy": {
    "workflow_path": ".github/workflows/test-full-suite.yml",
    "qualification": "separate-exact-sha-full-regression",
    "deployment_authority": false,
    "required_by_initial_ui_scope": false
  },
  "automatic_deployment": false,
  "initial_scopes": [
    "ui"
  ],
  "unsupported_scopes": [
    "backend",
    "host",
    "mihomo",
    "xray",
    "schema",
    "recovery"
  ],
  "prohibited_operations": [
    "git fetch",
    "git pull",
    "git checkout",
    "git reset",
    "git merge",
    "git clone",
    "deploy from downloaded artifacts",
    "automatic restart",
    "automatic reconcile"
  ],
  "temporary_log_days": 7,
  "permanent_receipts_in_tmpfiles_scope": false,
