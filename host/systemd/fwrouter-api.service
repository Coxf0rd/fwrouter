[Unit]
Description=FWRouter v2 FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fwrouter-api
EnvironmentFile=-/opt/fwrouter-api/.env
Environment=FWROUTER_BIND_HOST=127.0.0.1
Environment=FWROUTER_BIND_PORT=5000
ExecStartPre=/usr/local/libexec/fwrouter/fwrouter-boot-preflight.sh
ExecStart=/opt/fwrouter-api/.venv/bin/python -m uvicorn fwrouter_api.main:app --host 127.0.0.1 --port 5000 --no-access-log
Restart=on-failure
RestartSec=3
RuntimeDirectory=fwrouter-v2
TimeoutStartSec=120
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/fwrouter-v2 /var/log/fwrouter /run/fwrouter-v2 /etc/dnsmasq.d /etc/iproute2/rt_tables.d
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
