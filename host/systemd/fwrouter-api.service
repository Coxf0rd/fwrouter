[Unit]
Description=FWRouter v2 FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fwrouter-api
EnvironmentFile=-/opt/fwrouter-api/.env
ExecCondition=/opt/fwrouter-api/.venv/bin/python -m fwrouter_api_maintenance startup-check
ExecStart=/opt/fwrouter-api/.venv/bin/python -m fwrouter_api_maintenance run-api
Restart=on-failure
RestartSec=3
RuntimeDirectory=fwrouter-v2
UMask=0077
TimeoutStartSec=120
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/fwrouter-v2 /var/log/fwrouter /run/fwrouter-v2 /etc/dnsmasq.d /etc/iproute2/rt_tables.d
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
