{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FWRouter isolated kernel-dataplane acceptance profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile", "source_revision", "plan_digest", "xray", "mihomo", "chromium",
    "playwright_python", "baseline_xray_config_sha256", "ui_tree_sha256", "suite_nonce", "kernel_dataplane"
  ],
  "properties": {
    "schema": {"const": "fwrouter-acceptance-profile/v2"},
    "profile": {"const": "hosted-kernel-dataplane"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_digest": {"$ref": "#/$defs/sha256"},
    "xray": {"$ref": "#/$defs/binary"},
    "mihomo": {"$ref": "#/$defs/binary"},
    "chromium": {"$ref": "#/$defs/browser"},
    "playwright_python": {"type": "string", "minLength": 1},
    "baseline_xray_config_sha256": {"$ref": "#/$defs/sha256"},
    "ui_tree_sha256": {"$ref": "#/$defs/sha256"},
    "suite_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "kernel_dataplane": {
      "type": "object", "additionalProperties": false,
      "required": ["host_netns_inode_sha256", "dataplane_scripts"],
      "properties": {
        "host_netns_inode_sha256": {"$ref": "#/$defs/sha256"},
        "dataplane_scripts": {
          "type": "object", "additionalProperties": false,
          "required": [
            "host/libexec/fwrouter/dataplane-common.sh", "host/libexec/fwrouter/dataplane-check.sh",
            "host/libexec/fwrouter/dataplane-apply.sh", "host/libexec/fwrouter/dataplane-rollback.sh"
          ],
          "properties": {
            "host/libexec/fwrouter/dataplane-common.sh": {"$ref": "#/$defs/sha256"},
            "host/libexec/fwrouter/dataplane-check.sh": {"$ref": "#/$defs/sha256"},
            "host/libexec/fwrouter/dataplane-apply.sh": {"$ref": "#/$defs/sha256"},
            "host/libexec/fwrouter/dataplane-rollback.sh": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "browser": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "version", "bundle_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
